opam-version: "2.0"
synopsis: "DC, the program verifier for AC."
description:
  "DC is a program verifier for the AC programming language, that is designed to keep it simple. The verification is based on symbolic execution, while the assertion language supports separation logic."
authors: ["Jonas Pflanzer <noreply@example.com>"]
tags: [
  "DC"
  "AC"
  "verifier"
  "formal verification"
  "symbolic execution"
  "separation logic"
]
depends: [
  "dune" {>= "3.17"}
  "ocaml"
  "ppx_inline_test" {with-test}
  "menhir"
  "z3"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
