struct num {n: int} in
struct tuple {fib0: int, fib1: int} in
let n := malloc(num, 10) in
let fib := malloc(tuple, 0, 1) in
  (@ invariant !n.n >= 0 ** !fib.fib0 >= 0 ** !fib.fib1 >= 0 @
  while !n.n > 0 do
    !n.n := !n.n - 1;
    let x := !fib.fib0 + !fib.fib1 in
      !fib.fib1 := !fib.fib0;
      !fib.fib0 := x
  );
  !fib.fib0;
  @ result >= 0 @
