struct num { n: int} in
let n := malloc(num, 10) in
let fib := malloc(num, 0) in
let fib2 := malloc(num, 1) in
  (@ invariant !n.n >= 0 ** !fib.n >= 0 ** !fib2.n >= 0 @
  while !n.n > 0 do
    !n.n := !n.n - 1;
    let x := !fib.n + !fib2.n in
      !fib2.n := !fib.n;
      !fib.n := x
  );
  let res := !fib.n in
    res;
    @ result >= 0 @
