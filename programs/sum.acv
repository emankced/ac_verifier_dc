# emp
let sum := malloc(0) in
# sum -> 0 * emp * sum == _
let list := malloc(15, 3, 7, 10, 2, 5) in
# sum -> 0 * list -> 15 * list+1 -> 3 * list+2 -> 7 * list+3 -> 10 * list+4 -> 2 * list+5 -> 5 * emp * sum == _ * list == _
let size := 6 in
# sum -> 0 * list -> 15 * list+1 -> 3 * list+2 -> 7 * list+3 -> 10 * list+4 -> 2 * list+5 -> 5 * emp * sum == _ * list == _ * size == 6
  (for i in [0 to size-1] do
# sum -> _ * list -> 15 * list+1 -> 3 * list+2 -> 7 * list+3 -> 10 * list+4 -> 2 * list+5 -> 5 * emp * sum == _ * list == _ * size == 6 * 0 <= i * i < size
    !sum := !sum + !(list + i)
  );
# sum -> _ * list -> 15 * list+1 -> 3 * list+2 -> 7 * list+3 -> 10 * list+4 -> 2 * list+5 -> 5 * emp * sum == _ * list == _ * size == 6
  let result := !sum in
# sum -> ?vsum * list -> 15 * list+1 -> 3 * list+2 -> 7 * list+3 -> 10 * list+4 -> 2 * list+5 -> 5 * emp * sum == _ * list == _ * size == 6 * result == vsum
    mfree(list);
# sum -> ?vsum * emp * sum == _ * list == _ * size == 6 * result == vsum
    mfree(sum);
# emp * sum == _ * list == _ * size == 6 * result == _
    result
# emp
